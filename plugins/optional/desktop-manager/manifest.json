{
  "id": "desktop-manager",
  "name": "桌面管理",
  "version": "0.1.0",
  "category": "功能",
  "description": "智能体整理桌面文件：规则（不调模型）与 AI 增强两种策略，执行前确认、可整批回滚",
  "engine": "^0.1",
  "main": "backend/index.js",
  "permissions": ["fs", "desktop-shell", "llm", "data-contracts"],
  "contributes": {
    "tools": ["desktop_scan", "desktop_plan", "desktop_apply", "desktop_undo"],
    "reminders": { "path": "reminders/drain" },
    "windows": [
      {
        "id": "organize",
        "label": "整理",
        "entry": "frontend/layer.html",
        "placement": "desktop",
        "menu": true,
        "icon": "Monitor",
        "accelerator": "Control+Alt+D"
      },
      {
        "id": "peek",
        "label": "Peek",
        "entry": "frontend/peek.html",
        "placement": "overlay",
        "menu": false,
        "accelerator": "Control+Alt+Space"
      },
      {
        "id": "panel",
        "label": "设置",
        "entry": "frontend/settings.html",
        "placement": "normal",
        "rect": { "x": 200, "y": 100, "w": 640, "h": 720 },
        "resizable": true
      }
    ]
  }
}
