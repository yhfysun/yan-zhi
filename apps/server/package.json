{
  "name": "@yan-zhi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "言智后端服务：Express API、鉴权、商城服务端与 Playwright 浏览器自动化",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/fix-esm-extensions.cjs",
    "start": "node dist/apps/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node ./scripts/fix-sqlite-electron.cjs || true"
  },
  "dependencies": {
    "@yan-zhi/core": "workspace:*",
    "@yan-zhi/shared": "workspace:*",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "playwright": "^1.62.1",
    "simple-git": "^3.36.0",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^5.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
