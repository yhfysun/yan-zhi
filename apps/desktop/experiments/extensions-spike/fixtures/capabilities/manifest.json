{
  "manifest_version": 3,
  "name": "Spike Capabilities",
  "version": "1.0.0",
  "permissions": ["tabs", "storage", "cookies", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
