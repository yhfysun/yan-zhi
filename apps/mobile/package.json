{
  "name": "@yan-zhi/mobile",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "言智移动端（Capacitor，原生 SQLite 插件）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "icons:android": "node scripts/gen-android-icons.cjs",
    "native:sms": "node scripts/apply-native-sms.cjs",
    "build:mobile:server": "node scripts/build-mobile-server.cjs",
    "build:android": "node scripts/gen-android-icons.cjs && vite build && node scripts/build-mobile-server.cjs && node scripts/apply-native-sms.cjs && cap sync android && cap build android && node ./scripts/copy-apk.cjs",
    "build:ios": "vite build && node scripts/build-mobile-server.cjs && cap sync ios && cap build ios",
    "sync": "cap sync",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capawesome/capacitor-nodejs": "^0.1.1",
    "@element-plus/icons-vue": "^2.3.0",
    "@yan-zhi/core": "workspace:*",
    "@yan-zhi/shared": "workspace:*",
    "@yan-zhi/ui": "workspace:*",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.0"
  }
}
