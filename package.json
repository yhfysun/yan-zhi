{
  "name": "yan-zhi",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "言智 - 语言可控的智能体平台（Electron 桌面 / Web PWA / Capacitor 移动三端）",
  "scripts": {
    "dev": "pnpm --filter @yan-zhi/server dev",
    "dev:server": "pnpm --filter @yan-zhi/server dev",
    "dev:web": "pnpm --filter @yan-zhi/web dev",
    "dev:desktop": "pnpm --filter @yan-zhi/desktop dev",
    "dev:mobile": "pnpm --filter @yan-zhi/mobile dev",
    "build:web": "pnpm --filter @yan-zhi/web build",
    "build:desktop": "pnpm --filter @yan-zhi/desktop electron:build",
    "build:desktop:full": "pnpm --filter @yan-zhi/desktop electron:build:full",
    "build:desktop:lite": "pnpm --filter @yan-zhi/desktop electron:build:lite",
    "build:mobile:android": "pnpm --filter @yan-zhi/mobile build:android",
    "build:mobile:android:embedded": "pnpm --filter @yan-zhi/mobile build:android:embedded",
    "build:mobile-server": "pnpm --filter @yan-zhi/mobile build:mobile-server",
    "build:mobile:ios": "pnpm --filter @yan-zhi/mobile build:ios",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "gen:license": "node scripts/gen-license.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "canvas": "-"
    }
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
