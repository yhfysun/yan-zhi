# Auto-detect text/binary; let git handle line endings consistently across OS.
* text=auto

# Force LF for source files (avoids "needs update" noise on Windows checkouts)
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.cjs       text eol=lf
*.mjs       text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.sh        text eol=lf
*.py        text eol=lf

# Windows shell scripts must keep CRLF for native cmd/PowerShell to execute them
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary / generated / vendored — no normalization
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.node      binary
*.asar      binary
*.apk       binary
*.ipa       binary
*.gguf      binary
*.pem       binary
*.key       binary